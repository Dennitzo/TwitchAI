<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="TwitchAI.App.Views.AuditPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:tv="using:WinUI.TableView"
  Background="Transparent"
  SizeChanged="OnPageSizeChanged"
  mc:Ignorable="d">

  <Grid
    x:Name="AuditRoot"
    Margin="28,24,28,40"
    HorizontalAlignment="Stretch"
    RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="6">
      <TextBlock Style="{StaticResource PageTitleStyle}" Text="Ausführungslog" />
      <TextBlock
        Foreground="{ThemeResource MutedTextBrush}"
        Text="Freigabe, Twitch-Ergebnis und Lernentscheidung bleiben getrennt und nachvollziehbar."
        TextWrapping="Wrap" />
    </StackPanel>

    <InfoBar
      Grid.Row="1"
      IsClosable="False"
      IsOpen="True"
      Message="Das Log trennt Freigabe, Twitch-Ausführung und Lernentscheidung."
      Severity="Informational"
      Title="Nachvollziehbares Protokoll" />

    <Grid
      x:Name="AuditToolbar"
      Grid.Row="2"
      ColumnSpacing="12"
      RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="ToolbarSecondRow" Height="0" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ToolbarSearchColumn" Width="*" />
        <ColumnDefinition x:Name="ToolbarResultColumn" Width="170" />
        <ColumnDefinition x:Name="ToolbarPolicyColumn" Width="170" />
        <ColumnDefinition x:Name="ToolbarExportColumn" Width="Auto" />
      </Grid.ColumnDefinitions>

      <AutoSuggestBox
        x:Name="AuditSearchBox"
        MinWidth="180"
        AutomationProperties.Name="Ausführungslog nach Username, Nachricht oder Grund durchsuchen"
        PlaceholderText="Username, Nachricht oder Grund durchsuchen"
        QueryIcon="Find"
        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <ComboBox
        x:Name="ResultFilterBox"
        Grid.Column="1"
        MinWidth="140"
        AutomationProperties.Name="Ausführungslog nach Ergebnis filtern"
        Header="Ergebnis"
        SelectedValue="{x:Bind ViewModel.ResultFilter, Mode=TwoWay}"
        SelectedValuePath="Content">
        <ComboBoxItem Content="Alle" />
        <ComboBoxItem Content="Ausgeführt" />
        <ComboBoxItem Content="Verworfen" />
        <ComboBoxItem Content="Extern erledigt" />
        <ComboBoxItem Content="Unbekannt" />
      </ComboBox>

      <ComboBox
        x:Name="PolicyFilterBox"
        Grid.Column="2"
        MinWidth="140"
        AutomationProperties.Name="Ausführungslog nach Regelset filtern"
        Header="Regelset"
        SelectedValue="{x:Bind ViewModel.PolicyFilter, Mode=TwoWay}"
        SelectedValuePath="Content">
        <ComboBoxItem Content="Alle" />
        <ComboBoxItem Content="General" />
        <ComboBoxItem Content="Backseatgaming" />
      </ComboBox>

      <Button
        x:Name="AuditExportButton"
        Grid.Column="3"
        MinWidth="144"
        VerticalAlignment="Bottom"
        AutomationProperties.Name="Gefiltertes Ausführungslog als JSON exportieren"
        Click="OnExportClicked"
        IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
        Style="{StaticResource SubtleButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon FontSize="14" Glyph="&#xE896;" />
          <TextBlock Text="JSON exportieren" />
        </StackPanel>
      </Button>
    </Grid>

    <Border
      Grid.Row="3"
      MinHeight="260"
      Padding="0"
      Style="{StaticResource CardStyle}">
      <Grid>
        <tv:TableView
          x:Name="AuditTable"
          AutomationProperties.Name="Sortierbare Einträge des Ausführungslogs"
          AutoGenerateColumns="False"
          CanFilterColumns="False"
          CanReorderColumns="False"
          CanResizeColumns="True"
          CanSortColumns="True"
          IsReadOnly="True"
          ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
          MaxColumnWidth="900"
          MinColumnWidth="72"
          SelectionMode="None"
          ShowExportOptions="False"
          Sorting="OnAuditTableSorting">
          <tv:TableView.Columns>
            <tv:TableViewNumberColumn
              Binding="{Binding Id}"
              CanResize="True"
              CanSort="True"
              Header="ID"
              IsReadOnly="True"
              SortMemberPath="Id"
              Tag="Id"
              Width="90" />
            <tv:TableViewTextColumn
              Binding="{Binding OccurredAtDisplay}"
              CanResize="True"
              CanSort="True"
              Header="Zeitpunkt"
              SortMemberPath="OccurredAt"
              Tag="OccurredAt"
              Width="165" />
            <tv:TableViewTextColumn
              Binding="{Binding UserName}"
              CanResize="True"
              CanSort="True"
              Header="Username"
              SortMemberPath="UserName"
              Tag="UserName"
              Width="150" />
            <tv:TableViewTextColumn
              Binding="{Binding OriginalMessage}"
              CanResize="True"
              CanSort="True"
              Header="Nachricht"
              SortMemberPath="OriginalMessage"
              Tag="OriginalMessage"
              Width="2*" />
            <tv:TableViewTextColumn
              Binding="{Binding DecisionDetail}"
              CanResize="True"
              CanSort="True"
              Header="Entscheidung"
              SortMemberPath="DecisionDetail"
              Tag="DecisionDetail"
              Width="170" />
            <tv:TableViewTextColumn
              Binding="{Binding Reason}"
              CanResize="True"
              CanSort="True"
              Header="Begründung"
              SortMemberPath="Reason"
              Tag="Reason"
              Width="220" />
            <tv:TableViewTextColumn
              Binding="{Binding TwitchResult}"
              CanResize="True"
              CanSort="True"
              Header="Twitch-Ergebnis"
              SortMemberPath="TwitchResult"
              Tag="TwitchResult"
              Width="190" />
            <tv:TableViewTextColumn
              Binding="{Binding CategoryName}"
              CanResize="True"
              CanSort="True"
              Header="Kategorie"
              SortMemberPath="CategoryName"
              Tag="CategoryName"
              Width="160" />
            <tv:TableViewTextColumn
              Binding="{Binding PolicySet}"
              CanResize="True"
              CanSort="True"
              Header="Regelset"
              SortMemberPath="PolicySet"
              Tag="PolicySet"
              Width="150" />
          </tv:TableView.Columns>
        </tv:TableView>

        <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
          <FontIcon
            HorizontalAlignment="Center"
            FontSize="30"
            Foreground="{ThemeResource MutedTextBrush}"
            Glyph="&#xE9D5;" />
          <TextBlock
            Foreground="{ThemeResource MutedTextBrush}"
            Text="Keine passenden Logeinträge vorhanden." />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
