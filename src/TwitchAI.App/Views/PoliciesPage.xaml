<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="TwitchAI.App.Views.PoliciesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:tv="using:WinUI.TableView"
  xmlns:vm="using:TwitchAI.App.ViewModels"
  Background="Transparent"
  Loaded="Page_Loaded"
  SizeChanged="OnPageSizeChanged"
  mc:Ignorable="d">
  <ScrollViewer
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">
    <StackPanel
      x:Name="PageContent"
      Margin="28,24,28,40"
      HorizontalAlignment="Stretch"
      Spacing="18">
      <StackPanel Spacing="6">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Blacklist" />
        <TextBlock
          Foreground="{ThemeResource MutedTextBrush}"
          Text="Allgemeine Moderationsphrasen gelten unabhängig von der aktuellen Twitch-Kategorie."
          TextWrapping="Wrap" />
      </StackPanel>

      <InfoBar
        IsClosable="False"
        IsOpen="True"
        Message="Diese Phrasen gelten in jeder Twitch-Kategorie und können direkt in der Tabelle bearbeitet werden."
        Severity="Informational"
        Title="Allgemeines Regelset" />

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
              <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Phrase manuell hinzufügen" />
              <TextBlock
                Foreground="{ThemeResource MutedTextBrush}"
                Text="{x:Bind ViewModel.BroadcasterStatus, Mode=OneWay}"
                TextWrapping="Wrap" />
            </StackPanel>
            <ProgressRing
              Grid.Column="1"
              Width="22"
              Height="22"
              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
          </Grid>
          <Grid
            x:Name="PhraseForm"
            ColumnSpacing="10"
            RowSpacing="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="PhraseFormPrimaryColumn" Width="*" />
              <ColumnDefinition x:Name="PhraseFormActionColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
              Grid.ColumnSpan="2"
              Header="Verstoßkategorie"
              ItemsSource="{x:Bind ViewModel.RuleOptions}"
              SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}"
              ToolTipService.ToolTip="Aktive General-Regel, der die neue Phrase zugeordnet wird.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PolicyRuleOptionItem">
                  <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox
              x:Name="NewPhraseInput"
              Grid.Row="1"
              Header="Neue Blacklist-Phrase"
              MaxLength="500"
              PlaceholderText="Wird in Lowercase normalisiert"
              Text="{x:Bind ViewModel.NewPhrase, Mode=TwoWay}" />
            <Button
              x:Name="AddPhraseButton"
              Grid.Row="1"
              Grid.Column="1"
              VerticalAlignment="Bottom"
              Click="OnAddPhraseClicked"
              Content="Zeile hinzufügen"
              IsEnabled="{x:Bind ViewModel.CanAddPhrase, Mode=OneWay}"
              Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Padding="0" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid
            x:Name="TableToolsGrid"
            Padding="12,10"
            Background="{ThemeResource LayerStrongBrush}"
            ColumnSpacing="12"
            RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="TableCommandHint"
              VerticalAlignment="Center"
              Foreground="{ThemeResource MutedTextBrush}"
              Text="Eine Zeile auswählen, um sie global zu löschen."
              TextWrapping="Wrap" />
            <ComboBox
              x:Name="CategoryFilterBox"
              Grid.Column="1"
              MinWidth="250"
              Margin="0,0,8,0"
              AutomationProperties.Name="Blacklist nach Verstoßkategorie filtern"
              DisplayMemberPath="DisplayName"
              ItemsSource="{x:Bind ViewModel.CategoryFilters}"
              SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}" />
            <Button
              x:Name="DeleteRowButton"
              Grid.Column="2"
              AutomationProperties.Name="Ausgewählte Blacklist-Zeile löschen"
              Click="OnDeleteSelectedClicked"
              Foreground="{ThemeResource DangerBrush}"
              IsEnabled="{x:Bind ViewModel.CanDeleteSelected, Mode=OneWay}"
              Style="{StaticResource SubtleButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <SymbolIcon Symbol="Delete" />
                <TextBlock Text="Zeile löschen" />
              </StackPanel>
            </Button>
          </Grid>
          <tv:TableView
            x:Name="PhraseTable"
            Grid.Row="1"
            Height="420"
            AutomationProperties.Name="Sortierbare allgemeine Blacklist-Phrasen"
            AutoGenerateColumns="False"
            CellEditEnded="OnPhraseCellEditEnded"
            CanFilterColumns="False"
            CanReorderColumns="False"
            CanResizeColumns="True"
            CanSortColumns="True"
            IsReadOnly="False"
            ItemsSource="{x:Bind ViewModel.SortedPhrases, Mode=OneWay}"
            MaxColumnWidth="900"
            MinColumnWidth="72"
            SelectionChanged="OnPhraseSelectionChanged"
            SelectionMode="Multiple"
            ShowExportOptions="False"
            Sorting="OnPhraseTableSorting">
          <tv:TableView.Columns>
            <tv:TableViewNumberColumn
              Binding="{Binding PhraseId}"
              CanResize="True"
              CanSort="True"
              Header="ID"
              IsReadOnly="True"
              SortMemberPath="PhraseId"
              Tag="PhraseId"
              Width="90" />
            <tv:TableViewTextColumn
              Binding="{Binding Phrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              CanResize="True"
              CanSort="True"
              Header="Lowercase-Phrase"
              IsReadOnly="False"
              SortMemberPath="Phrase"
              Tag="Phrase"
              Width="2*" />
            <tv:TableViewTemplateColumn
              CanResize="True"
              CanSort="True"
              Header="Kategorie"
              IsReadOnly="False"
              SortMemberPath="Code"
              Tag="Code"
              Width="240">
              <tv:TableViewTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PolicyPhraseItem">
                  <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind RuleTitle}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind RuleTitle}" />
                </DataTemplate>
              </tv:TableViewTemplateColumn.CellTemplate>
              <tv:TableViewTemplateColumn.EditingTemplate>
                <DataTemplate x:DataType="vm:PolicyPhraseItem">
                  <ComboBox
                    MinWidth="210"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind RuleOptions}"
                    SelectedItem="{x:Bind SelectedRuleOption, Mode=TwoWay}" />
                </DataTemplate>
              </tv:TableViewTemplateColumn.EditingTemplate>
            </tv:TableViewTemplateColumn>
            <tv:TableViewComboBoxColumn
              CanResize="True"
              CanSort="True"
              Header="Override"
              IsEditable="False"
              IsReadOnly="False"
              ItemsSource="{x:Bind ViewModel.OverrideOptions, Mode=OneWay}"
              SelectedValueBinding="{Binding Override, Mode=TwoWay}"
              SortMemberPath="Override"
              Tag="Override"
              Width="120" />
            <tv:TableViewTextColumn
              Binding="{Binding FeedbackLabel}"
              CanResize="True"
              CanSort="True"
              Header="+ / − Feedback"
              IsReadOnly="True"
              SortMemberPath="Feedback"
              Tag="Feedback"
              Width="140" />
            <tv:TableViewTemplateColumn
              CanResize="True"
              CanSort="True"
              Header="Aktiv"
              IsReadOnly="True"
              SortMemberPath="IsEnabled"
              Tag="IsEnabled"
              Width="100">
              <tv:TableViewTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PolicyPhraseItem">
                  <ToggleSwitch
                    AutomationProperties.Name="Blacklist-Phrase aktivieren oder deaktivieren"
                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                    OffContent=""
                    OnContent=""
                    Tag="{x:Bind}"
                    Toggled="PhraseEnabled_Toggled" />
                </DataTemplate>
              </tv:TableViewTemplateColumn.CellTemplate>
            </tv:TableViewTemplateColumn>
          </tv:TableView.Columns>
          </tv:TableView>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
