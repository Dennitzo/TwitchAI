<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="TwitchAI.App.Views.DatabasePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:tv="using:WinUI.TableView"
  xmlns:vm="using:TwitchAI.App.ViewModels"
  Background="Transparent"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  mc:Ignorable="d">
  <ScrollViewer
    x:Name="DatabasePageScroller"
    HorizontalContentAlignment="Stretch"
    HorizontalScrollBarVisibility="Disabled"
    HorizontalScrollMode="Disabled"
    VerticalScrollBarVisibility="Hidden"
    VerticalScrollMode="Disabled">
    <Grid
      x:Name="DatabaseLayout"
      Margin="28,24,28,32"
      ColumnSpacing="14"
      RowSpacing="18">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="WideDatabaseLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="1280" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="DatabasePageScroller.VerticalScrollMode" Value="Disabled" />
              <Setter Target="DatabasePageScroller.VerticalScrollBarVisibility" Value="Hidden" />
              <Setter Target="DatabaseLayout.Margin" Value="28,24,28,32" />
              <Setter Target="DatabaseLayout.MinHeight" Value="0" />
              <Setter Target="DatabaseLayout.ColumnSpacing" Value="14" />
              <Setter Target="CatalogColumn.Width" Value="250" />
              <Setter Target="DataColumn.Width" Value="*" />
              <Setter Target="PrimaryContentRow.Height" Value="*" />
              <Setter Target="SecondaryContentRow.Height" Value="0" />
              <Setter Target="TableCatalogCard.(Grid.Row)" Value="3" />
              <Setter Target="TableCatalogCard.(Grid.Column)" Value="0" />
              <Setter Target="TableCatalogCard.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="DataGridCard.(Grid.Row)" Value="3" />
              <Setter Target="DataGridCard.(Grid.Column)" Value="1" />
              <Setter Target="DataGridCard.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PaginationSecondRow.Height" Value="0" />
              <Setter Target="PaginationActionColumn.Width" Value="Auto" />
              <Setter Target="PaginationSummaryPanel.Orientation" Value="Horizontal" />
              <Setter Target="PaginationSummaryPanel.(Grid.Row)" Value="0" />
              <Setter Target="PaginationSummaryPanel.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PaginationButtonPanel.(Grid.Row)" Value="0" />
              <Setter Target="PaginationButtonPanel.(Grid.Column)" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="MediumDatabaseLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="900" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="DatabasePageScroller.VerticalScrollMode" Value="Enabled" />
              <Setter Target="DatabasePageScroller.VerticalScrollBarVisibility" Value="Auto" />
              <Setter Target="DatabaseLayout.Margin" Value="20,20,20,28" />
              <Setter Target="DatabaseLayout.MinHeight" Value="760" />
              <Setter Target="DatabaseLayout.ColumnSpacing" Value="14" />
              <Setter Target="CatalogColumn.Width" Value="230" />
              <Setter Target="DataColumn.Width" Value="*" />
              <Setter Target="PrimaryContentRow.Height" Value="*" />
              <Setter Target="SecondaryContentRow.Height" Value="0" />
              <Setter Target="TableCatalogCard.(Grid.Row)" Value="3" />
              <Setter Target="TableCatalogCard.(Grid.Column)" Value="0" />
              <Setter Target="TableCatalogCard.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="DataGridCard.(Grid.Row)" Value="3" />
              <Setter Target="DataGridCard.(Grid.Column)" Value="1" />
              <Setter Target="DataGridCard.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PaginationSecondRow.Height" Value="0" />
              <Setter Target="PaginationActionColumn.Width" Value="Auto" />
              <Setter Target="PaginationSummaryPanel.Orientation" Value="Horizontal" />
              <Setter Target="PaginationSummaryPanel.(Grid.Row)" Value="0" />
              <Setter Target="PaginationSummaryPanel.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PaginationButtonPanel.(Grid.Row)" Value="0" />
              <Setter Target="PaginationButtonPanel.(Grid.Column)" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CompactDatabaseLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="DatabasePageScroller.VerticalScrollMode" Value="Enabled" />
              <Setter Target="DatabasePageScroller.VerticalScrollBarVisibility" Value="Auto" />
              <Setter Target="DatabaseLayout.Margin" Value="72,16,12,24" />
              <Setter Target="DatabaseLayout.MinHeight" Value="940" />
              <Setter Target="DatabaseLayout.ColumnSpacing" Value="0" />
              <Setter Target="CatalogColumn.Width" Value="*" />
              <Setter Target="DataColumn.Width" Value="0" />
              <Setter Target="PrimaryContentRow.Height" Value="190" />
              <Setter Target="SecondaryContentRow.Height" Value="620" />
              <Setter Target="TableCatalogCard.(Grid.Row)" Value="3" />
              <Setter Target="TableCatalogCard.(Grid.Column)" Value="0" />
              <Setter Target="TableCatalogCard.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="DataGridCard.(Grid.Row)" Value="4" />
              <Setter Target="DataGridCard.(Grid.Column)" Value="0" />
              <Setter Target="DataGridCard.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PaginationSecondRow.Height" Value="Auto" />
              <Setter Target="PaginationActionColumn.Width" Value="0" />
              <Setter Target="PaginationSummaryPanel.Orientation" Value="Vertical" />
              <Setter Target="PaginationSummaryPanel.(Grid.Row)" Value="0" />
              <Setter Target="PaginationSummaryPanel.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="PaginationButtonPanel.(Grid.Row)" Value="1" />
              <Setter Target="PaginationButtonPanel.(Grid.Column)" Value="0" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="PrimaryContentRow" Height="*" />
        <RowDefinition x:Name="SecondaryContentRow" Height="0" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="CatalogColumn" Width="250" />
        <ColumnDefinition x:Name="DataColumn" Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.ColumnSpan="2" Spacing="6">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Datenbank" />
        <TextBlock
          Foreground="{ThemeResource MutedTextBrush}"
          Text="Alle fachlichen Tabellen können direkt bearbeitet, ergänzt und gelöscht werden. Änderungen werden automatisch gespeichert."
          TextWrapping="Wrap" />
        <InfoBar
          Margin="0,10,0,0"
          IsClosable="False"
          IsOpen="True"
          Message="Mehrere Zeilen können ausgewählt werden. Bearbeitungen werden direkt gespeichert; Löschen entfernt auch abhängige Datensätze."
          Severity="Informational"
          Title="Direkte Datenbearbeitung" />
      </StackPanel>

      <Grid
        x:Name="DatabaseQueryBar"
        Grid.Row="1"
        Grid.ColumnSpan="2">
        <AutoSuggestBox
          x:Name="SearchBox"
          HorizontalAlignment="Stretch"
          AutomationProperties.Name="Aktuelle Datenbanktabelle serverseitig durchsuchen"
          PlaceholderText="Serverseitig durchsuchen"
          QueryIcon="Find"
          QuerySubmitted="OnSearchSubmitted"
          Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          ToolTipService.ToolTip="Enter startet eine parametrisierte Suche über die aktuelle Tabelle." />
      </Grid>

      <CommandBar
      x:Name="DatabaseCommandBar"
      Grid.Row="2"
      Grid.ColumnSpan="2"
      Background="{ThemeResource LayerBrush}"
      CornerRadius="10"
      DefaultLabelPosition="Right"
      IsDynamicOverflowEnabled="True">
      <AppBarButton
        AutomationProperties.Name="Datenbanktabelle aktualisieren"
        Click="OnReloadClicked"
        Icon="Refresh"
        IsEnabled="{x:Bind ViewModel.CanReload, Mode=OneWay}"
        Label="Aktualisieren" />
      <AppBarButton
        AutomationProperties.Name="{x:Bind ViewModel.AddRowLabel, Mode=OneWay}"
        Click="OnAddRowClicked"
        Icon="Add"
        IsEnabled="{x:Bind ViewModel.CanAddRow, Mode=OneWay}"
        Label="{x:Bind ViewModel.AddRowLabel, Mode=OneWay}" />
      <AppBarButton
        AutomationProperties.Name="{x:Bind ViewModel.DeleteActionLabel, Mode=OneWay}"
        Click="OnDeleteRowClicked"
        Icon="Delete"
        IsEnabled="{x:Bind ViewModel.CanDeleteSelected, Mode=OneWay}"
        Label="{x:Bind ViewModel.DeleteActionLabel, Mode=OneWay}" />
      <AppBarSeparator />
      <AppBarButton
        AutomationProperties.Name="Ausgewählten Datensatz als JSON kopieren"
        Click="OnCopyClicked"
        Icon="Copy"
        Label="Datensatz kopieren" />
      <AppBarButton
        AutomationProperties.Name="Sichtbare Datenbankseite als JSON exportieren"
        Click="OnExportJsonClicked"
        Icon="Save"
        IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
        Label="JSON exportieren" />
      <AppBarButton
        AutomationProperties.Name="Sichtbare Datenbankseite als CSV exportieren"
        Click="OnExportCsvClicked"
        Icon="Save"
        IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
        Label="CSV exportieren" />
      </CommandBar>

      <Border
      x:Name="TableCatalogCard"
      Grid.Row="3"
      Padding="8"
      Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView
          x:Name="TableList"
          AutomationProperties.Name="Verfügbare Anwendungstabellen"
          IsItemClickEnabled="True"
          ItemsSource="{x:Bind ViewModel.Tables}"
          SelectedItem="{x:Bind ViewModel.SelectedTable, Mode=OneWay}"
          SelectionChanged="OnTableSelectionChanged"
          SelectionMode="Single">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:DatabaseTableItem">
              <Grid Padding="6,9" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind DisplayName}" />
                  <TextBlock
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Text="{x:Bind Name}" />
                </StackPanel>
                <StackPanel
                  Grid.Column="1"
                  HorizontalAlignment="Right"
                  Spacing="2">
                  <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Text="{x:Bind RowCountLabel, Mode=OneWay}" />
                  <FontIcon
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Glyph="&#xE72E;" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
          <TextBlock
            Grid.Row="1"
            Margin="8,8,8,4"
            FontSize="11"
            Foreground="{ThemeResource MutedTextBrush}"
            Text="SQLite-Systemtabellen werden nicht exponiert. Trefferzahlen sind exakt."
            TextWrapping="Wrap" />
      </Grid>
    </Border>

      <Border
      x:Name="DataGridCard"
      Grid.Row="3"
      Grid.Column="1"
      Padding="0"
      Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
          Padding="18,14"
          Background="{ThemeResource LayerStrongBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock
              FontSize="16"
              FontWeight="SemiBold"
              Text="{x:Bind ViewModel.SelectedTableDisplayName, Mode=OneWay}" />
            <TextBlock
              FontFamily="Consolas"
              FontSize="11"
              Foreground="{ThemeResource MutedTextBrush}"
              Text="{x:Bind ViewModel.SelectedTableName, Mode=OneWay}" />
          </StackPanel>
          <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Right"
            Spacing="5">
            <Border Style="{StaticResource StatusPillStyle}">
              <TextBlock
                FontSize="11"
                Text="{x:Bind ViewModel.SelectedTableAccess, Mode=OneWay}" />
            </Border>
            <ProgressRing
              Width="18"
              Height="18"
              HorizontalAlignment="Right"
              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
          </StackPanel>
        </Grid>

        <tv:TableView
          x:Name="DataTable"
          Grid.Row="1"
          AutomationProperties.Name="Datensätze der ausgewählten Tabelle"
          AutoGenerateColumns="False"
          CanFilterColumns="False"
          CanReorderColumns="False"
          CanResizeColumns="True"
          CanSortColumns="True"
          CellEditEnded="OnCellEditEnded"
          IsReadOnly="False"
          ItemsSource="{x:Bind ViewModel.Rows}"
          MaxColumnWidth="900"
          MinColumnWidth="80"
          SelectionChanged="OnRowSelectionChanged"
          SelectionMode="Multiple"
          ShowExportOptions="False"
          Sorting="OnDataTableSorting" />

        <Grid
          x:Name="PaginationFooter"
          Grid.Row="2"
          Padding="16,10"
          Background="{ThemeResource LayerStrongBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PaginationSecondRow" Height="0" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PaginationActionColumn" Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
            x:Name="PaginationSummaryPanel"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
            <TextBlock
              VerticalAlignment="Center"
              Foreground="{ThemeResource MutedTextBrush}"
              Text="{x:Bind ViewModel.PageSummary, Mode=OneWay}" />
            <ComboBox
              x:Name="PageSizeBox"
              MinWidth="76"
              AutomationProperties.Name="Zeilen pro Datenbankseite"
              Header="Zeilen"
              ItemsSource="{x:Bind ViewModel.PageSizes}"
              SelectedItem="{x:Bind ViewModel.PageSize, Mode=OneWay}"
              SelectionChanged="OnPageSizeChanged" />
          </StackPanel>
          <StackPanel
            x:Name="PaginationButtonPanel"
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <Button
              AutomationProperties.Name="Vorherige Datenbankseite"
              Click="OnPreviousPageClicked"
              Content="Zurück"
              IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
            <Button
              AutomationProperties.Name="Aktuelle Datenbankseitennummer"
              Content="{x:Bind ViewModel.PageNumber, Mode=OneWay}"
              IsEnabled="False" />
            <Button
              AutomationProperties.Name="Nächste Datenbankseite"
              Click="OnNextPageClicked"
              Content="Weiter"
              IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    </Grid>
  </ScrollViewer>
</Page>
