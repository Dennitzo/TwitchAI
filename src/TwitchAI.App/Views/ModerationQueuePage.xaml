<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="TwitchAI.App.Views.ModerationQueuePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:TwitchAI.App.ViewModels"
  Background="Transparent"
  Loaded="OnPageLoaded"
  SizeChanged="OnPageSizeChanged"
  Unloaded="OnPageUnloaded"
  mc:Ignorable="d">

  <Grid
    x:Name="PageContent"
    Margin="28,24,28,40"
    HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="6">
      <TextBlock
        Style="{StaticResource PageTitleStyle}"
        Text="Moderationswarteschlange" />
      <TextBlock
        Foreground="{ThemeResource MutedTextBrush}"
        Text="AI-Vorschläge bleiben lokal gebunden und werden erst nach deiner Freigabe ausgeführt."
        TextWrapping="Wrap" />
    </StackPanel>

    <InfoBar
      Grid.Row="1"
      Margin="0,20,0,16"
      IsClosable="False"
      IsOpen="True"
      Message="Vorschläge werden erst nach „Ausführen“ an Twitch gesendet."
      Severity="Informational"
      Title="Menschliche Freigabe" />

    <Grid Grid.Row="2">
      <StackPanel
        x:Name="EmptyState"
        MaxWidth="520"
        Margin="0,54"
        HorizontalAlignment="Center"
        Spacing="12">
        <Border
          Width="64"
          Height="64"
          HorizontalAlignment="Center"
          Background="{ThemeResource LayerStrongBrush}"
          CornerRadius="20">
          <FontIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="26"
            Foreground="{ThemeResource TwitchAccentBrush}"
            Glyph="&#xE8F2;" />
        </Border>
        <TextBlock
          HorizontalAlignment="Center"
          Style="{StaticResource SectionTitleStyle}"
          Text="Keine offenen Vorschläge" />
        <TextBlock
          HorizontalAlignment="Center"
          Foreground="{ThemeResource MutedTextBrush}"
          Text="Sobald eine validierte AI-Entscheidung vorliegt, erscheint sie hier zur menschlichen Prüfung."
          TextAlignment="Center"
          TextWrapping="Wrap" />
      </StackPanel>

      <ItemsRepeater
        x:Name="CasesRepeater"
        HorizontalAlignment="Stretch"
        Visibility="Collapsed">
        <ItemsRepeater.Layout>
          <StackLayout Spacing="10" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:ModerationCaseItem">
            <Border
              Padding="12"
              HorizontalAlignment="Stretch"
              Style="{StaticResource CardStyle}">
              <Grid
                RowSpacing="8"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                  x:Name="IdentityHeader"
                  RowSpacing="5"
                  SizeChanged="OnIdentityHeaderSizeChanged">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CaseStatusColumn" Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border
                      Width="30"
                      Height="30"
                      Background="{ThemeResource TwitchAccentBrush}"
                      CornerRadius="15">
                      <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="White"
                        Glyph="&#xE77B;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                      <TextBlock
                        MaxLines="1"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind UserName}"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        MaxLines="1"
                        FontSize="10"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Text="{x:Bind ReceivedAtDisplay}"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        MaxLines="1"
                        FontSize="10"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Text="{x:Bind ChannelDisplayLabel}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ChannelDisplayLabel}" />
                      <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource WarningBrush}"
                        Text="{x:Bind ProposalOriginLabel}"
                        Visibility="{x:Bind ProposalOriginVisibility}" />
                    </StackPanel>
                  </StackPanel>
                  <Border
                    x:Name="CaseStatus"
                    Grid.Column="1"
                    MinHeight="24"
                    Padding="8,2"
                    HorizontalAlignment="Right"
                    Background="#24F4B860"
                    Style="{StaticResource StatusPillStyle}">
                    <TextBlock
                      MaxLines="1"
                      FontSize="11"
                      Foreground="{ThemeResource WarningBrush}"
                      Text="{x:Bind Status}"
                      TextTrimming="CharacterEllipsis" />
                  </Border>
                </Grid>

                <Border
                  Grid.Row="1"
                  Padding="10,7"
                  HorizontalAlignment="Stretch"
                  Background="{ThemeResource LayerStrongBrush}"
                  BorderBrush="{ThemeResource CardStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                  <Grid MinWidth="0" ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                      Background="{ThemeResource TwitchAccentBrush}"
                      CornerRadius="2" />
                    <TextBlock
                      Grid.Column="1"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      FontFamily="Segoe UI Variable Text"
                      FontSize="15"
                      IsTextSelectionEnabled="True"
                      MaxLines="0"
                      Text="{x:Bind OriginalMessage}"
                      TextTrimming="None"
                      TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <Expander
                  Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  Header="AI-Trefferbeleg"
                  HorizontalContentAlignment="Stretch"
                  Visibility="{x:Bind TriggerEvidenceVisibility, Mode=OneWay}">
                  <ItemsControl
                    Margin="0,4,0,0"
                    ItemsSource="{x:Bind TriggerPhrases}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TriggerPhraseItem">
                        <CheckBox
                          MinHeight="28"
                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                          <TextBlock
                            Text="{x:Bind Phrase}"
                            TextWrapping="Wrap" />
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>

                <Border
                  Grid.Row="3"
                  Padding="10"
                  Background="{ThemeResource LayerStrongBrush}"
                  CornerRadius="8">
                  <Grid
                    x:Name="ReviewGrid"
                    MinWidth="0"
                    ColumnSpacing="8"
                    RowSpacing="8"
                    SizeChanged="OnReviewGridSizeChanged">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="230" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="5" Margin="0,0,0,1">
                      <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind ReviewTitle}" />
                      <ProgressRing
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Right"
                        IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                    </Grid>

                    <ComboBox
                      x:Name="ActionEditor"
                      Grid.Row="1"
                      Grid.Column="0"
                      Header="Aktion"
                      HorizontalAlignment="Stretch"
                      SelectedValue="{x:Bind Action, Mode=TwoWay}"
                      SelectedValuePath="Tag"
                      Visibility="{x:Bind ModerationEditorVisibility, Mode=OneWay}">
                      <ComboBoxItem
                        Content="Nachricht löschen"
                        Tag="delete"
                        Visibility="{x:Bind DeleteActionVisibility, Mode=OneWay}" />
                      <ComboBoxItem Content="Timeout" Tag="timeout" />
                      <ComboBoxItem Content="Ban" Tag="ban" />
                    </ComboBox>

                    <NumberBox
                      x:Name="TimeoutEditor"
                      Grid.Row="1"
                      Grid.Column="1"
                      Header="Timeout (Sekunden)"
                      HorizontalAlignment="Stretch"
                      Maximum="1209600"
                      MinWidth="145"
                      Minimum="1"
                      SmallChange="30"
                      Value="{x:Bind TimeoutSeconds, Mode=TwoWay}"
                      Visibility="{x:Bind TimeoutEditorVisibility, Mode=OneWay}" />

                    <ComboBox
                      x:Name="ViolationEditor"
                      Grid.Row="1"
                      Grid.Column="2"
                      Header="Verstoßkategorie"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{x:Bind ViolationRuleOptions, Mode=OneWay}"
                      PlaceholderText="{x:Bind ViolationCategoryDisplayName, Mode=OneWay}"
                      SelectedValue="{x:Bind RuleCode, Mode=OneWay}"
                      SelectedValuePath="Code"
                      SelectionChanged="OnViolationCategorySelectionChanged"
                      Tag="{x:Bind}"
                      Visibility="{x:Bind ModerationEditorVisibility, Mode=OneWay}" />

                    <TextBox
                      x:Name="ReasonEditor"
                      Grid.Row="2"
                      Grid.Column="0"
                      Grid.ColumnSpan="5"
                      Header="Begründung und Hinweis"
                      HorizontalAlignment="Stretch"
                      AcceptsReturn="False"
                      MaxLength="120"
                      MinHeight="136"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Text="{x:Bind Reason, Mode=TwoWay}"
                      TextWrapping="Wrap"
                      VerticalContentAlignment="Top"
                      Visibility="{x:Bind ReasonEditorVisibility, Mode=OneWay}" />

                    <TextBlock
                      x:Name="ReasonStatusText"
                      Grid.Row="3"
                      Grid.Column="0"
                      Grid.ColumnSpan="5"
                      FontSize="11"
                      Foreground="{ThemeResource MutedTextBrush}"
                      Text="{x:Bind ReasonGenerationStatus, Mode=OneWay}"
                      TextWrapping="Wrap"
                      Visibility="{x:Bind ReasonGenerationStatusVisibility, Mode=OneWay}" />

                    <TextBox
                      x:Name="ChatReplyEditor"
                      Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="4"
                      Header="Antwortnachricht"
                      HorizontalAlignment="Stretch"
                      IsReadOnly="True"
                      Text="{x:Bind ReplyMessage}"
                      TextWrapping="Wrap"
                      Visibility="{x:Bind ChatReplyEditorVisibility, Mode=OneWay}" />

                    <StackPanel
                      x:Name="ActionButtons"
                      Grid.Row="1"
                      Grid.Column="4"
                      Spacing="4">
                      <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Text="Aktionen" />
                      <Grid
                        x:Name="ModerationActionButtonsGrid"
                        ColumnSpacing="8"
                        RowSpacing="8"
                        SizeChanged="OnModerationActionButtonsSizeChanged"
                        Visibility="{x:Bind ModerationEditorVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                          x:Name="AllowButton"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Vorschlag erlauben"
                          Click="OnAllowClicked"
                          Content="Erlauben"
                          IsEnabled="{x:Bind CanAllow, Mode=OneWay}"
                          MinWidth="0"
                          Padding="8"
                          Tag="{x:Bind}"
                          ToolTipService.ToolTip="Als erlaubt lernen und Vorschlag schließen; ein aktueller AutoMod-Hold wird nicht bei Twitch freigegeben"
                          Visibility="{x:Bind AllowActionVisibility, Mode=OneWay}"
                          Style="{StaticResource SubtleButtonStyle}" />
                        <Button
                          x:Name="DiscardModerationButton"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Vorschlag verwerfen"
                          Click="OnDiscardClicked"
                          Content="Verwerfen"
                          IsEnabled="{x:Bind CanDiscard, Mode=OneWay}"
                          MinWidth="0"
                          Padding="8"
                          Tag="{x:Bind}"
                          ToolTipService.ToolTip="Ohne Learning verwerfen"
                          Style="{StaticResource SubtleButtonStyle}" />
                        <Button
                          x:Name="ExecuteModerationButton"
                          Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Vorschlag ausführen"
                          Click="OnExecuteClicked"
                          Content="Ausführen"
                          IsEnabled="{x:Bind CanExecute, Mode=OneWay}"
                          MinWidth="0"
                          Padding="8"
                          Tag="{x:Bind}"
                          ToolTipService.ToolTip="Moderationsaktion direkt ausführen"
                          Style="{StaticResource AccentButtonStyle}" />
                      </Grid>
                      <Grid
                        ColumnSpacing="8"
                        Visibility="{x:Bind ChatReplyEditorVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Chat-Antwort verwerfen"
                          Click="OnDiscardClicked"
                          Content="Verwerfen"
                          IsEnabled="{x:Bind CanDiscard, Mode=OneWay}"
                          Tag="{x:Bind}"
                          ToolTipService.ToolTip="Chat-Antwort ohne Senden verwerfen"
                          Style="{StaticResource SubtleButtonStyle}" />
                        <Button
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Chat-Antwort ausführen"
                          Click="OnExecuteClicked"
                          Content="Ausführen"
                          IsEnabled="{x:Bind CanExecute, Mode=OneWay}"
                          Tag="{x:Bind}"
                          ToolTipService.ToolTip="Chat-Antwort direkt senden"
                          Style="{StaticResource AccentButtonStyle}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </Grid>
  </Grid>
</Page>
